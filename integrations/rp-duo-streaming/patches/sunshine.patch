+  /// Send one local pad snapshot without blocking the stream.
+#ifdef __APPLE__
+  static std::atomic<input_t *> rp_pad_owner {};  ///< One stream controls the local game.
+
+  static void send_rp_pad(const input_t::rp_pad_frame &frame) {
+    const auto path = rpduo::haptics_ingress::default_path();
+    if (path.empty()) {
+      return;
+    }
+    sockaddr_un addr {};
+    addr.sun_family = AF_UNIX;
+    const auto pad_path = path.substr(0, path.rfind('/') + 1) + "pad.sock";
+    if (pad_path.size() >= sizeof(addr.sun_path)) {
+      return;
+    }
+    std::memcpy(addr.sun_path, pad_path.c_str(), pad_path.size() + 1);
+    const int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    if (fd < 0) {
+      return;
+    }
+    if (fcntl(fd, F_SETFL, O_NONBLOCK) == 0) {
+      sendto(fd, &frame, sizeof(frame), 0, reinterpret_cast<sockaddr *>(&addr), sizeof(addr));
+    }
+    close(fd);
+  }
+#endif
+
+  void enable_rp_pad(const std::shared_ptr<input_t> &input, bool enabled) {
+#ifdef __APPLE__
+    std::lock_guard lock {input->rp_pad_mutex};
+    if (enabled) {
+      auto *expected = static_cast<input_t *>(nullptr);
+      enabled = rp_pad_owner.compare_exchange_strong(expected, input.get()) || expected == input.get();
+    } else if (input->rp_pad_enabled) {
+      send_rp_pad({});
+      auto *expected = input.get();
+      rp_pad_owner.compare_exchange_strong(expected, nullptr);
+    }
+    input->rp_pad_enabled = enabled;
+    input->rp_pad_state.reset();
+#endif
+  }
+
+  void refresh_rp_pad(const std::shared_ptr<input_t> &input) {
+#ifdef __APPLE__
+    std::lock_guard lock {input->rp_pad_mutex};
+    auto now = std::chrono::steady_clock::now();
+    if (input->rp_pad_enabled && input->rp_pad_state && now - input->rp_pad_sent >= std::chrono::milliseconds(75)) {
+      send_rp_pad(*input->rp_pad_state);
+      input->rp_pad_sent = now;
+    }
+#endif
+  }
+
   void passthrough(std::shared_ptr<input_t> &input, PNV_MULTI_CONTROLLER_PACKET packet) {
+#ifdef __APPLE__
+    if (config::input.controller && config::input.gamepad_driver == config::GAMEPAD_DRIVER_NONE && packet->controllerNumber == 0) {
+      std::lock_guard lock {input->rp_pad_mutex};
+      if (input->rp_pad_enabled) {
+        input_t::rp_pad_frame frame;
+        if (packet->activeGamepadMask & 1) {
+          frame = {0x31445052, static_cast<uint16_t>(packet->buttonFlags), packet->leftTrigger, packet->rightTrigger, packet->leftStickX, packet->leftStickY, packet->rightStickX, packet->rightStickY};
+          input->rp_pad_state = frame;
+        } else {
+          input->rp_pad_state.reset();
+        }
+        send_rp_pad(frame);
+        input->rp_pad_sent = std::chrono::steady_clock::now();
+        return;
+      }
+    }
+#endif
     if (!config::input.controller || config::input.gamepad_driver == config::GAMEPAD_DRIVER_NONE) {
       return;
     }
