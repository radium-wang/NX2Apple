@@ -0,0 +1,138 @@
+/**
+ * @file src/platform/macos/rpduo_audio_buffer.h
+ * @brief Bound timing variation between the NX2Apple PCM producer and the Opus encoder.
+ */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace platf::rpduo_audio {
+  /** @brief Buffer ordered stereo PCM for one direct stream on its capture thread. */
+  class buffer_t {
+  public:
+    static constexpr std::size_t channels = 2;  ///< Number of interleaved channels.
+    static constexpr std::size_t block_samples = 480;  ///< 5 ms of 48 kHz stereo PCM.
+    static constexpr std::size_t prebuffer_blocks = 7;  ///< 35 ms before starting or resuming.
+    static constexpr std::size_t maximum_blocks = 32;  ///< Emergency capacity, not the target latency.
+    using block_t = std::array<std::int16_t, block_samples>;
+
+    /** @brief Add one ordered block, discarding old audio on excessive queue growth. */
+    void push(const block_t &block) {
+      if (size == blocks.size()) {
+        const auto dropped = size - (prebuffer_blocks - 1);
+        head = (head + dropped) % blocks.size();
+        size -= dropped;
+        offset = 0;
+        ready = false;
+        fade_in = 0;
+        ++overruns;
+      }
+      blocks[(head + size) % blocks.size()] = block;
+      ++size;
+    }
+
+    /** @brief Reset the queue after the capture thread misses multiple frame deadlines. */
+    void reset() {
+      head = size = offset = fade_in = 0;
+      ready = false;
+    }
+
+    /**
+     * @brief Render one encoder frame with short fades at discontinuities.
+     * @param output Interleaved stereo float output.
+     */
+    void read(std::span<float> output) {
+      const auto available = size * block_samples - offset;
+      if (!ready && available >= std::max(prebuffer_blocks * block_samples, output.size())) {
+        ready = true;
+        fade_in = fade_frames;
+        fade_in_origin = last;
+      }
+      // Keep the nominal queue intact through ordinary jitter. If audio stays ahead of playback,
+      // overlap it with the next millisecond to shorten the queue without a packet-sized skip.
+      constexpr std::size_t trim_frames = 48;  // One millisecond at 48 kHz.
+      constexpr std::size_t high_water = 13 * block_samples;  // 65 ms.
+      const auto overlap = std::min(fade_frames, output.size() / channels);
+      const bool trim = ready && !fade_in && overlap && available > high_water &&
+                        available >= output.size() + trim_frames * channels;
+      for (std::size_t index = 0; index < output.size(); index += channels) {
+        if (ready && size == 0) {
+          ready = false;
+          ++underruns;
+        }
+        if (ready) {
+          const float gain = 1.0f - fade_in / static_cast<float>(fade_frames);
+          const auto overlap_index = index / channels;
+          for (std::size_t channel = 0; channel < channels; ++channel) {
+            float value = sample(channel);
+            if (trim && overlap_index < overlap) {
+              const float mix = (overlap_index + 1) / static_cast<float>(overlap);
+              value += (sample(trim_frames * channels + channel) - value) * mix;
+            }
+            last[channel] = fade_in_origin[channel] * (1.0f - gain) + value * gain;
+            output[index + channel] = fade_out_origin[channel] = last[channel];
+          }
+          fade_out = fade_frames;
+          if (fade_in) {
+            --fade_in;
+          }
+          consume(channels);
+          if (trim && overlap_index + 1 == overlap) {
+            consume(trim_frames * channels);
+            smoothed_frames += trim_frames;
+          }
+        } else {
+          const float gain = fade_out / static_cast<float>(fade_frames);
+          for (std::size_t channel = 0; channel < channels; ++channel) {
+            output[index + channel] = last[channel] = fade_out_origin[channel] * gain;
+          }
+          if (fade_out) {
+            --fade_out;
+          }
+        }
+      }
+    }
+
+    std::uint64_t underruns {};  ///< Number of times playback ran out of buffered samples.
+    std::uint64_t overruns {};  ///< Number of times queued audio was trimmed.
+    std::uint64_t smoothed_frames {};  ///< Stereo sample frames removed with a short overlap.
+
+  private:
+    /**
+     * @brief Read a sample relative to the playback cursor from the interleaved queue.
+     * @param ahead Distance from the cursor in individual channel samples.
+     */
+    float sample(std::size_t ahead) const {
+      const auto position = offset + ahead;
+      return blocks[(head + position / block_samples) % blocks.size()][position % block_samples] / 32768.0f;
+    }
+
+    /**
+     * @brief Advance the playback cursor by samples known to be available.
+     * @param count Number of individual channel samples to consume.
+     */
+    void consume(std::size_t count) {
+      const auto next = offset + count;
+      const auto consumed_blocks = next / block_samples;
+      offset = next % block_samples;
+      head = (head + consumed_blocks) % blocks.size();
+      size -= consumed_blocks;
+    }
+
+    static constexpr std::size_t fade_frames = 96;  ///< 2 ms transition at 48 kHz.
+    std::array<block_t, maximum_blocks> blocks {};  ///< Bounded storage for pending PCM.
+    std::size_t head {};  ///< First block in the queue.
+    std::size_t size {};  ///< Number of blocks in the queue.
+    std::size_t offset {};  ///< First unplayed sample in the head block.
+    std::size_t fade_in {};  ///< Frames left in the fade-in.
+    std::size_t fade_out {};  ///< Frames left in the fade-out.
+    std::array<float, channels> last {};  ///< Last output before a gap.
+    std::array<float, channels> fade_in_origin {};  ///< Output when the fade-in began.
+    std::array<float, channels> fade_out_origin {};  ///< Output when the fade-out began.
+    bool ready {};  ///< Playback has gathered enough data to start.
+  };
+}  // namespace platf::rpduo_audio
