  * @file src/platform/macos/microphone.mm
  * @brief Definitions for microphone capture on macOS.
  */
+// standard includes
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <utility>
+
+// platform includes
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
 // local includes
 #include "src/config.h"
 #include "src/logging.h"
 #include "src/platform/common.h"
 #include "src/platform/macos/av_audio.h"
+#include "src/platform/macos/rpduo_audio_buffer.h"
 
 namespace platf {
   using namespace std::literals;
 
+  /**
+   * @brief Consume 5 ms stereo PCM datagrams from the NX2Apple game directly.
+   */
+  struct relay_mic_t final: public mic_t {
+    /** @brief One 5 ms block of interleaved stereo PCM16 with its host timestamp. */
+    struct packet_t {
+      std::uint64_t uptime_ns;  ///< Clock shared with the producer.
+      rpduo_audio::buffer_t::block_t samples;  ///< 240 frames at 48 kHz.
+    };
+    static_assert(sizeof(packet_t) == 968);
+    using clock = std::chrono::steady_clock;
+
+    ~relay_mic_t() override {
+      if (buffer.underruns || buffer.overruns || stale_packets || buffer.smoothed_frames || resyncs || peak_late >= 5ms) {
+        BOOST_LOG(info) << "NX2Apple audio relay: underruns="sv << buffer.underruns
+                        << ", overruns="sv << buffer.overruns << ", stale packets="sv << stale_packets
+                        << ", smoothed frames="sv << buffer.smoothed_frames << ", resyncs="sv << resyncs
+                        << ", max capture delay="sv << std::chrono::duration_cast<std::chrono::milliseconds>(peak_late).count() << " ms"sv;
+      }
+      if (socket_fd >= 0) {
+        close(socket_fd);
+      }
+      struct stat current {};
+      if (socket_file.st_ino && lstat(path.c_str(), &current) == 0 &&
+          current.st_dev == socket_file.st_dev && current.st_ino == socket_file.st_ino) {
+        unlink(path.c_str());
+      }
+    }
+
+    /**
+     * @brief Open a private local audio socket with no microphone or system audio access.
+     * @param socket_path Absolute path to a new socket in an owned private directory.
+     * @return Whether the endpoint was opened.
+     */
+    bool open_socket(std::string socket_path) {
+      sockaddr_un address {};
+      const auto slash = socket_path.rfind('/');
+      if (slash == 0 || slash == std::string::npos || socket_path[0] != '/' ||
+          slash + 1 == socket_path.size() || socket_path.size() >= sizeof address.sun_path) {
+        return false;
+      }
+
+      const auto directory = socket_path.substr(0, slash);
+      struct stat owner {};
+      if (lstat(directory.c_str(), &owner) != 0 || !S_ISDIR(owner.st_mode) ||
+          owner.st_uid != geteuid() || (owner.st_mode & 0077)) {
+        return false;
+      }
+
+      socket_fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+      if (socket_fd < 0 || fcntl(socket_fd, F_SETFD, FD_CLOEXEC) != 0 ||
+          fcntl(socket_fd, F_SETFL, O_NONBLOCK) != 0) {
+        return false;
+      }
+      // Darwin's default Unix datagram receive buffer holds only a few 5 ms blocks.
+      const int receive_bytes = 64 * 1024;
+      setsockopt(socket_fd, SOL_SOCKET, SO_RCVBUF, &receive_bytes, sizeof receive_bytes);
+      address.sun_family = AF_UNIX;
+      std::memcpy(address.sun_path, socket_path.c_str(), socket_path.size() + 1);
+      address.sun_len = SUN_LEN(&address);
+      if (bind(socket_fd, reinterpret_cast<const sockaddr *>(&address), address.sun_len) != 0) {
+        return false;
+      }
+      path = std::move(socket_path);
+      return lstat(path.c_str(), &socket_file) == 0;
+    }
+
+    /**
+     * @brief Feed the Opus encoder at its negotiated cadence, substituting silence for missing blocks.
+     * @param output Interleaved stereo float samples for one encoder frame.
+     * @return Audio capture status.
+     */
+    capture_e sample(std::vector<float> &output) override {
+      const auto now = clock::now();
+      std::uint64_t discard_before = 0;
+      if (deadline == clock::time_point {}) {
+        deadline = now;
+      } else {
+        const auto late = now - deadline;
+        peak_late = std::max(peak_late, late);
+        // Keep the encoder cadence across short scheduling stalls. Moving the deadline to now
+        // after every stall would accumulate that lost playback time in the PCM queue.
+        if (late > 100ms) {
+          deadline = now;
+          buffer.reset();
+          const auto uptime = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+          constexpr auto recovery_window_ns = rpduo_audio::buffer_t::prebuffer_blocks * 5000000ull;
+          discard_before = uptime > recovery_window_ns ? uptime - recovery_window_ns : 0;
+          ++resyncs;
+        }
+      }
+      deadline += std::chrono::nanoseconds(output.size() * 1000000000ull / 96000);
+      receive_packets(discard_before);
+      std::this_thread::sleep_until(deadline);
+      buffer.read(output);
+      return capture_e::ok;
+    }
+
+  private:
+    /**
+     * @brief Drain available packets even if the encoder deadline has already passed.
+     * @param discard_before Drop datagrams older than this uptime after a long interruption.
+     */
+    void receive_packets(std::uint64_t discard_before) {
+      for (int received_count = 0; received_count < 128; ++received_count) {
+        // A larger receive buffer lets us recognize and reject truncated datagrams.
+        struct {
+          packet_t value;
+          std::uint8_t guard;
+        } received {};
+        const auto size = recv(socket_fd, &received, sizeof received, MSG_DONTWAIT);
+        if (size == static_cast<ssize_t>(sizeof(packet_t))) {
+          const auto now_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+          if (received.value.uptime_ns > now_ns || received.value.uptime_ns < discard_before ||
+              now_ns - received.value.uptime_ns > 120000000ull) {
+            ++stale_packets;
+            continue;
+          }
+          buffer.push(received.value.samples);
+          const auto &samples = received.value.samples;
+          if (!reported_audio && std::any_of(samples.begin(), samples.end(), [](auto value) { return value != 0; })) {
+            reported_audio = true;
+            BOOST_LOG(info) << "NX2Apple audio relay: received game audio"sv;
+          }
+          continue;
+        }
+        if (size >= 0 || errno == EINTR) {
+          continue;
+        }
+        if (errno != EAGAIN && errno != EWOULDBLOCK) {
+          return;
+        }
+
+        pollfd pending {socket_fd, POLLIN, 0};
+        auto remaining = std::chrono::ceil<std::chrono::milliseconds>(deadline - clock::now()).count();
+        if (remaining <= 0) {
+          return;
+        }
+        const auto result = poll(&pending, 1, static_cast<int>(remaining));
+        if ((result < 0 && errno != EINTR) || (result > 0 && !(pending.revents & POLLIN))) {
+          return;
+        }
+      }
+    }
+
+    int socket_fd {-1};  ///< Bound PCM endpoint.
+    std::string path;  ///< Filesystem name used to remove the endpoint.
+    struct stat socket_file {};  ///< Identity of this stream's own endpoint.
+    rpduo_audio::buffer_t buffer;  ///< PCM waiting for the encoder.
+    std::uint64_t stale_packets {};  ///< Packets too far behind the host clock.
+    std::uint64_t resyncs {};  ///< Number of severe interruptions that reset playback.
+    clock::duration peak_late {};  ///< Longest interruption of the capture loop.
+    clock::time_point deadline {};  ///< Next negotiated delivery time.
+    bool reported_audio {};  ///< Whether we verified that the game sent nonzero PCM.
+  };
+
   /**
    * @brief macOS microphone capture device and audio format state.
    */
@@ -93,6 +271,16 @@ int set_sink(const std::string &sink) override {
      * @return Microphone capture object for the requested audio layout.
      */
     std::unique_ptr<mic_t> microphone(const std::uint8_t *mapping, int channels, std::uint32_t sample_rate, std::uint32_t frame_size, bool continuous_audio, bool host_audio_enabled) override {
+      if (const char *socket_path = std::getenv("RPDUO_STREAM_AUDIO_SOCKET"); socket_path && *socket_path) {
+        auto relay = std::make_unique<relay_mic_t>();
+        if (channels != 2 || sample_rate != 48000 || !relay->open_socket(socket_path)) {
+          BOOST_LOG(error) << "NX2Apple audio relay requires stereo 48 kHz and a new socket in a private directory"sv;
+          return nullptr;
+        }
+        BOOST_LOG(info) << "NX2Apple audio relay: awaiting game audio"sv;
+        return relay;
+      }
+
       auto mic = std::make_unique<av_mic_t>();
       mic->av_audio_capture = [[AVAudio alloc] init];
 
