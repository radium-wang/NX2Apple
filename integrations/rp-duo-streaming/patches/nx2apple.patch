+static void rpduo_pad_start(NSWindow *window) {
+    struct sockaddr_un addr;
+    if (!rpduo_address(&addr, "pad.sock")) return;
+    char lock_path[sizeof addr.sun_path + 6];
+    snprintf(lock_path, sizeof lock_path, "%s.lock", addr.sun_path);
+    int lock = open(lock_path, O_CREAT | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (lock < 0) return;
+    if (flock(lock, LOCK_EX | LOCK_NB)) { close(lock); return; }
+    int fd = rpduo_socket();
+    if (fd < 0) { close(lock); return; }
+    unlink(addr.sun_path);
+    if (bind(fd, (struct sockaddr *)&addr, sizeof addr) || chmod(addr.sun_path, 0600)) {
+        close(fd);
+        close(lock);
+        return;
+    }
+    // Keep the socket and exclusive lock for the lifetime of this game process.
+    __block uint64_t last = 0;
+    dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+    dispatch_source_set_timer(timer, DISPATCH_TIME_NOW, 4 * NSEC_PER_MSEC, NSEC_PER_MSEC);
+    dispatch_source_set_event_handler(timer, ^{
+        int active = window.isKeyWindow && NSApp.isActive && !window.miniaturized;
+        uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC);
+        for (int i = 0; i < 64; i++) {
+            union { rpduo_pad_frame pad; unsigned char bytes[17]; } packet;
+            ssize_t n = recv(fd, packet.bytes, sizeof packet.bytes, 0);
+            if (n < 0) break;
+            if (!active || n != sizeof packet.pad || packet.pad.magic != 0x31445052) continue;
+            rpduo_pad_frame pad = packet.pad;
+            dm_stream_pad(rpduo_switch_buttons(pad), pad.lx, pad.ly, pad.rx, pad.ry);
+            last = now;
+        }
+        if (last && (!active || now - last >= 250 * NSEC_PER_MSEC)) {
+            dm_stream_pad(0, 0, 0, 0, 0);
+            last = 0;
+        }
+    });
+    dispatch_resume(timer);
+    static dispatch_source_t retained_timer;
+    retained_timer = timer;
+    (void)retained_timer;
+}
