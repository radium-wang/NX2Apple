+static void relay_read_options(void) {
+    const char *service = getenv("DM_STREAM_RELAY");
+    if (service && *service) g_relay_service = service;
+}
+
+static bool relay_enabled(void) {
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    pthread_once(&once, relay_read_options);
+    return g_relay_service != NULL;
+}
+
+static void relay_start(void) {
+    NSDictionary *attributes = @{
+        (id)kCVPixelBufferWidthKey: @(RELAY_WIDTH),
+        (id)kCVPixelBufferHeightKey: @(RELAY_HEIGHT),
+        (id)kCVPixelBufferPixelFormatTypeKey: @(kCVPixelFormatType_32BGRA),
+        (id)kCVPixelBufferIOSurfacePropertiesKey: @{},
+        (id)kCVPixelBufferMetalCompatibilityKey: @YES,
+    };
+    CVReturn status = CVPixelBufferPoolCreate(kCFAllocatorDefault, NULL,
+        (__bridge CFDictionaryRef)attributes, &g_relay_pool);
+    if (status != kCVReturnSuccess) {
+        MLOG("stream relay: could not create pixel buffer pool (%d)", status);
+        return;
+    }
+    g_relay_pool_limits = @{ (id)kCVPixelBufferPoolAllocationThresholdKey: @(RELAY_POOL_LIMIT) };
+    g_relay_queue = dispatch_queue_create("org.nx2apple.stream-relay", DISPATCH_QUEUE_SERIAL);
+    g_relay_connection = xpc_connection_create_mach_service(g_relay_service, g_relay_queue, 0);
+    if (!g_relay_connection) {
+        MLOG("stream relay: could not create connection to %s", g_relay_service);
+        return;
+    }
+    xpc_connection_set_event_handler(g_relay_connection, ^(xpc_object_t event) {
+        if (event == XPC_ERROR_CONNECTION_INVALID) MLOG("stream relay: connection invalid (%s)", g_relay_service);
+    });
+    xpc_connection_resume(g_relay_connection);
+    MLOG("stream relay: sending %dx%d BGRA frames to %s", RELAY_WIDTH, RELAY_HEIGHT, g_relay_service);
+}
+
+static void relay_release_frame(CVPixelBufferRef buffer) {
+    if (buffer) CVPixelBufferRelease(buffer);
+    atomic_store(&g_relay_busy, false);
+}
+
+static void relay_present(id<MTLTexture> src, const int crop[4]) {
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    pthread_once(&once, relay_start);
+    if (!g_relay_connection || atomic_exchange(&g_relay_busy, true)) return;
+
+    CVPixelBufferRef buffer = NULL;
+    CVReturn status = CVPixelBufferPoolCreatePixelBufferWithAuxAttributes(kCFAllocatorDefault,
+        g_relay_pool, (__bridge CFDictionaryRef)g_relay_pool_limits, &buffer);
+    if (status != kCVReturnSuccess) {
+        if (status != kCVReturnWouldExceedAllocationThreshold)
+            MLOG("stream relay: could not allocate pixel buffer (%d)", status);
+        relay_release_frame(buffer);
+        return;
+    }
+
+    IOSurfaceRef surface = CVPixelBufferGetIOSurface(buffer);
+    MTLTextureDescriptor *desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+        width:RELAY_WIDTH height:RELAY_HEIGHT mipmapped:NO];
+    desc.storageMode = MTLStorageModeShared;
+    desc.usage = MTLTextureUsageRenderTarget;
+    id<MTLTexture> dst = surface ? [g_dev newTextureWithDescriptor:desc iosurface:surface plane:0] : nil;
+    if (!dst) {
+        MLOG("stream relay: could not create Metal texture from IOSurface");
+        relay_release_frame(buffer);
+        return;
+    }
+    uint64_t seq = ++g_relay_sequence;
+    if (!present_offscreen_m4_cached(src, crop, dst, &g_relay_fx, ^(int kind) {
+        if (kind == PRESENT_FAILED) {
+            relay_release_frame(buffer);
+            return;
+        }
+        uint64_t ready_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        xpc_object_t description = IOSurfaceCreateXPCObject(surface);
+        if (!description) {
+            relay_release_frame(buffer);
+            return;
+        }
+        xpc_object_t message = xpc_dictionary_create(NULL, NULL, 0);
+        xpc_dictionary_set_string(message, "op", "frame");
+        xpc_dictionary_set_value(message, "surface", description);
+        xpc_dictionary_set_uint64(message, "seq", seq);
+        xpc_dictionary_set_uint64(message, "ts_ns", ready_ns);
+        // The receiver replies after its last read. Until then the pool must not reuse the bytes.
+        IOSurfaceIncrementUseCount(surface);
+        xpc_connection_send_message_with_reply(g_relay_connection, message, g_relay_queue, ^(xpc_object_t reply) {
+            (void)reply;
+            IOSurfaceDecrementUseCount(surface);
+            relay_release_frame(buffer);
+        });
+    })) relay_release_frame(buffer);
+}
