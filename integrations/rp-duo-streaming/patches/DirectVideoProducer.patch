+#if TARGET_OS_OSX
+enum { RELAY_WIDTH = 1920, RELAY_HEIGHT = 1080, RELAY_POOL_LIMIT = 3 };
+static CVPixelBufferPoolRef g_relay_pool;
+static NSDictionary *g_relay_pool_limits;
+static xpc_connection_t g_relay_connection;
+static dispatch_queue_t g_relay_queue;
