diff --git a/src/rpduo_audio_diagnostics.h b/src/rpduo_audio_diagnostics.h
new file mode 100644
--- /dev/null
+++ b/src/rpduo_audio_diagnostics.h
@@ -0,0 +1,83 @@
+/**
+ * @file src/rpduo_audio_diagnostics.h
+ * @brief Periodic timing counters for the direct game audio path.
+ */
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+
+#include "logging.h"
+
+namespace rpduo_audio_diagnostics {
+  using clock = std::chrono::steady_clock;
+
+  /** @brief Whether the host is capturing audio from the direct game relay. */
+  inline bool enabled() {
+    const char *path = std::getenv("RPDUO_STREAM_AUDIO_SOCKET");
+    return path && *path;
+  }
+
+  /** @brief Aggregate timing and loss counts without logging individual packets. */
+  class window_t {
+  public:
+    /**
+     * @brief Record one stage of the audio stream and log each ten-second interval.
+     * @param stage Name of the stage producing this sample.
+     * @param arrival Start time of work on this audio packet.
+     * @param period Negotiated duration of the audio packet.
+     * @param wait Time elapsed between enqueue and the start of work.
+     * @param work Time elapsed while processing the packet.
+     * @param dropped Number of queued packets skipped before this packet.
+     * @param failed Whether the data packet failed to reach the socket.
+     */
+    void record(const char *stage, clock::time_point arrival, clock::duration period,
+                clock::duration wait = {}, clock::duration work = {}, std::uint64_t dropped = 0, bool failed = false) {
+      using namespace std::chrono_literals;
+      if (previous != clock::time_point {}) {
+        const auto gap = arrival - previous;
+        peak_gap = std::max(peak_gap, gap);
+        gaps += gap > period * 2;
+        bursts += gap < period / 2;
+      }
+      previous = arrival;
+      if (next_report == clock::time_point {}) {
+        next_report = arrival + 10s;
+      }
+      ++packets;
+      lost += dropped;
+      failures += failed;
+      peak_wait = std::max(peak_wait, wait);
+      peak_work = std::max(peak_work, work);
+      if (arrival >= next_report) {
+        BOOST_LOG(info) << "NX2Apple audio timing (" << stage << "): packets=" << packets
+                        << ", gaps >2 frames=" << gaps << ", bursts <1/2 frame=" << bursts
+                        << ", queue drops=" << lost << ", send failures=" << failures
+                        << ", max gap us=" << micros(peak_gap) << ", max queue wait us=" << micros(peak_wait)
+                        << ", max work us=" << micros(peak_work);
+        *this = {};
+        previous = arrival;
+        next_report = arrival + 10s;
+      }
+    }
+
+  private:
+    /** @brief Convert a host clock interval to microseconds for the log. */
+    static std::chrono::microseconds::rep micros(clock::duration interval) {
+      return std::chrono::duration_cast<std::chrono::microseconds>(interval).count();
+    }
+
+    clock::time_point previous {};  ///< Arrival time of the previous packet.
+    clock::time_point next_report {};  ///< Earliest time for the next aggregate.
+    clock::duration peak_gap {};  ///< Longest interruption between packets.
+    clock::duration peak_wait {};  ///< Longest measured queue wait.
+    clock::duration peak_work {};  ///< Longest operation on this stage.
+    std::uint64_t packets {};  ///< Packets observed in the report window.
+    std::uint64_t gaps {};  ///< Intervals exceeding twice the negotiated duration.
+    std::uint64_t bursts {};  ///< Intervals shorter than half the negotiated duration.
+    std::uint64_t lost {};  ///< Missing packets detected in queue arrival sequence.
+    std::uint64_t failures {};  ///< Failed data-packet sends.
+  };
+}  // namespace rpduo_audio_diagnostics
