+#if TARGET_OS_OSX
+enum { RELAY_AUDIO_FRAMES = RATE / 200 };
+typedef struct {
+    uint64_t uptime_ns;
+    int16_t samples[RELAY_AUDIO_FRAMES * 2];
+} relay_audio_packet;
+_Static_assert(sizeof(relay_audio_packet) == 968, "unexpected stream audio packet layout");
+
+static int g_audio_relay_fd = -1;
+static struct sockaddr_un g_audio_relay_addr;
+static _Atomic(aout *) g_audio_relay_output;
+
+static void audio_relay_init(void) {
+    const char *path = getenv("DM_STREAM_AUDIO_SOCKET");
+    if (!path || !*path) return;
+    size_t size = strlen(path);
+    if (path[0] != '/' || size >= sizeof g_audio_relay_addr.sun_path) {
+        LOG("[RED] stream audio: invalid Unix socket path");
+        return;
+    }
+    char parent[sizeof g_audio_relay_addr.sun_path];
+    memcpy(parent, path, size + 1);
+    char *last = strrchr(parent, '/');
+    if (last == parent || !last[1]) {
+        LOG("[RED] stream audio: a private socket directory is required");
+        return;
+    }
+    *last = '\0';
+    struct stat st;
+    if (lstat(parent, &st) || !S_ISDIR(st.st_mode) || st.st_uid != geteuid() || (st.st_mode & 0077)) {
+        LOG("[RED] stream audio: the socket directory must be private and owned by this user");
+        return;
+    }
+    int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    if (fd < 0 || fcntl(fd, F_SETFD, FD_CLOEXEC) || fcntl(fd, F_SETFL, O_NONBLOCK)) {
+        if (fd >= 0) close(fd);
+        LOG("[RED] stream audio: cannot open the nonblocking Unix socket");
+        return;
+    }
+    g_audio_relay_addr.sun_family = AF_UNIX;
+    memcpy(g_audio_relay_addr.sun_path, path, size + 1);
+    g_audio_relay_addr.sun_len = SUN_LEN(&g_audio_relay_addr);
+    g_audio_relay_fd = fd;
+    LOG("stream audio: sending 48 kHz stereo PCM to the local relay");
+}
+
+static bool audio_relay_enabled(void) {
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    pthread_once(&once, audio_relay_init);
+    return g_audio_relay_fd >= 0;
+}
+
+static bool audio_relay_pull(aout *a) {
+    if (g_audio_relay_fd < 0 || (a->ch != 1 && a->ch != 2 && a->ch != 6)) return false;
+    // A stream uses one guest audio device. Keep later outputs paced without interleaving their packets.
+    aout *owner = NULL;
+    if (!atomic_compare_exchange_strong(&g_audio_relay_output, &owner, a) && owner != a) return false;
+
+    relay_audio_packet packet;
+    if (a->ch == 1) {
+        int16_t mono[RELAY_AUDIO_FRAMES];
+        pull(a, (uint8_t *)mono, sizeof mono);
+        for (unsigned i = 0; i < RELAY_AUDIO_FRAMES; i++) {
+            packet.samples[i * 2] = mono[i];
+            packet.samples[i * 2 + 1] = mono[i];
+        }
+    } else {
+        pull_device(a, (uint8_t *)packet.samples, sizeof packet.samples);
     }
+    packet.uptime_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    // A missing or slow receiver must never stall the game's audio queue.
+    (void)sendto(g_audio_relay_fd, &packet, sizeof packet, MSG_DONTWAIT,
+                 (const struct sockaddr *)&g_audio_relay_addr, g_audio_relay_addr.sun_len);
+    return true;
 }
+#endif
 
