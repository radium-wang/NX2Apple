+    jbyteArray bytes = (*env)->NewByteArray(env, 64);
+    if (bytes) {
+        (*env)->SetByteArrayRegion(env, bytes, 0, 64, (const jbyte *)frame);
+        (*env)->CallStaticVoidMethod(env, GlobalBridgeClass, BridgeClRawHapticsMethod, bytes);
+        (*env)->DeleteLocalRef(env, bytes);
+    }
+    if ((*env)->ExceptionCheck(env)) { (*env)->ExceptionDescribe(env); (*env)->ExceptionClear(env); }
